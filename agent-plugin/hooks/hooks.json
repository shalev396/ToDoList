{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*todolist.*__create_todo",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-create-todo.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*todolist.*__builder_(add_block|update_block|arrange|connect_blocks|apply_patch|apply_template|remove_block|revert)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-builder-write.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*todolist.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*todolist.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
