{
	"AWSTemplateFormatVersion": "2010-09-09",
	"Description": "TodoList (dev): CloudFront, S3, HTTP API + Lambda, Cognito, SES",
	"Metadata": {
		"AWS::Composer::Groups": {
			"Edge": {
				"Label": "Edge",
				"Members": [
					"EmailIdentity",
					"DkimRecord1",
					"DkimRecord2",
					"DkimRecord3",
					"Certificate",
					"OriginAccessControl",
					"SpaRewrite",
					"Distribution",
					"AliasRecord"
				]
			},
			"Api": {
				"Label": "Api",
				"Members": [
					"HttpApi"
				]
			},
			"Compute": {
				"Label": "Compute",
				"Members": [
					"DependenciesLayer",
					"CodebaseLayer",
					"LogGroup",
					"FunctionRole"
				]
			},
			"Storage": {
				"Label": "Storage",
				"Members": [
					"ClientBucket",
					"AssetsBucket",
					"CredentialsKey",
					"CredentialsKeyAlias"
				]
			},
			"Auth": {
				"Label": "Auth",
				"Members": [
					"UserPool",
					"UserPoolClient"
				]
			}
		}
	},
	"Parameters": {
		"DatabaseUrl": {
			"Type": "String",
			"Description": "DATABASE_URL connection string. Passed at deploy time; never stored in the template.",
			"MinLength": 1,
			"NoEcho": true
		}
	},
	"Mappings": {
		"AWSCloudFrontPartitionHostedZoneIdMap": {
			"aws": {
				"zoneId": "Z2FDTNDATAQYW2"
			},
			"aws-cn": {
				"zoneId": "Z3RFFRIM2A3IF5"
			}
		}
	},
	"Resources": {
		"ClientBucket": {
			"Type": "AWS::S3::Bucket",
			"Properties": {
				"BucketName": {
					"Fn::Join": [
						"",
						[
							"dev.example.com"
						]
					]
				},
				"Tags": [
					{
						"Key": "Project",
						"Value": "todolist"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			}
		},
		"ClientBucketPolicy": {
			"Type": "AWS::S3::BucketPolicy",
			"Properties": {
				"Bucket": {
					"Ref": "ClientBucket"
				},
				"PolicyDocument": {
					"Statement": [
						{
							"Action": "s3:*",
							"Condition": {
								"Bool": {
									"aws:SecureTransport": "false"
								}
							},
							"Effect": "Deny",
							"Principal": {
								"AWS": "*"
							},
							"Resource": [
								{
									"Fn::GetAtt": [
										"ClientBucket",
										"Arn"
									]
								},
								{
									"Fn::Join": [
										"",
										[
											{
												"Fn::GetAtt": [
													"ClientBucket",
													"Arn"
												]
											},
											"/*"
										]
									]
								}
							]
						},
						{
							"Action": [
								"s3:GetObject",
								"s3:ListBucket"
							],
							"Condition": {
								"StringEquals": {
									"AWS:SourceArn": {
										"Fn::Join": [
											"",
											[
												"arn:",
												{
													"Ref": "AWS::Partition"
												},
												":cloudfront::",
												{
													"Ref": "AWS::AccountId"
												},
												":distribution/",
												{
													"Ref": "Distribution"
												}
											]
										]
									}
								}
							},
							"Effect": "Allow",
							"Principal": {
								"Service": "cloudfront.amazonaws.com"
							},
							"Resource": [
								{
									"Fn::GetAtt": [
										"ClientBucket",
										"Arn"
									]
								},
								{
									"Fn::Join": [
										"",
										[
											{
												"Fn::GetAtt": [
													"ClientBucket",
													"Arn"
												]
											},
											"/*"
										]
									]
								}
							]
						}
					],
					"Version": "2012-10-17"
				}
			}
		},
		"AssetsBucket": {
			"Type": "AWS::S3::Bucket",
			"Properties": {
				"BucketName": {
					"Fn::Join": [
						"",
						[
							"dev.example.com-assets"
						]
					]
				},
				"Tags": [
					{
						"Key": "Project",
						"Value": "todolist"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			}
		},
		"AssetsBucketPolicy": {
			"Type": "AWS::S3::BucketPolicy",
			"Properties": {
				"Bucket": {
					"Ref": "AssetsBucket"
				},
				"PolicyDocument": {
					"Statement": [
						{
							"Action": "s3:*",
							"Condition": {
								"Bool": {
									"aws:SecureTransport": "false"
								}
							},
							"Effect": "Deny",
							"Principal": {
								"AWS": "*"
							},
							"Resource": [
								{
									"Fn::GetAtt": [
										"AssetsBucket",
										"Arn"
									]
								},
								{
									"Fn::Join": [
										"",
										[
											{
												"Fn::GetAtt": [
													"AssetsBucket",
													"Arn"
												]
											},
											"/*"
										]
									]
								}
							]
						},
						{
							"Action": "s3:GetObject",
							"Condition": {
								"StringEquals": {
									"AWS:SourceArn": {
										"Fn::Join": [
											"",
											[
												"arn:",
												{
													"Ref": "AWS::Partition"
												},
												":cloudfront::",
												{
													"Ref": "AWS::AccountId"
												},
												":distribution/",
												{
													"Ref": "Distribution"
												}
											]
										]
									}
								}
							},
							"Effect": "Allow",
							"Principal": {
								"Service": "cloudfront.amazonaws.com"
							},
							"Resource": {
								"Fn::Join": [
									"",
									[
										{
											"Fn::GetAtt": [
												"AssetsBucket",
												"Arn"
											]
										},
										"/*"
									]
								]
							}
						}
					],
					"Version": "2012-10-17"
				}
			}
		},
		"EmailIdentity": {
			"Type": "AWS::SES::EmailIdentity",
			"Properties": {
				"DkimSigningAttributes": {
					"NextSigningKeyLength": "RSA_2048_BIT"
				},
				"EmailIdentity": "dev.example.com",
				"Tags": [
					{
						"Key": "Project",
						"Value": "todolist"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			}
		},
		"DkimRecord1": {
			"Type": "AWS::Route53::RecordSet",
			"Properties": {
				"HostedZoneId": "Z0000000000000FIXTURE",
				"Name": {
					"Fn::Join": [
						"",
						[
							{
								"Fn::GetAtt": [
									"EmailIdentity",
									"DkimDNSTokenName1"
								]
							},
							"."
						]
					]
				},
				"ResourceRecords": [
					{
						"Fn::GetAtt": [
							"EmailIdentity",
							"DkimDNSTokenValue1"
						]
					}
				],
				"TTL": "300",
				"Type": "CNAME"
			}
		},
		"DkimRecord2": {
			"Type": "AWS::Route53::RecordSet",
			"Properties": {
				"HostedZoneId": "Z0000000000000FIXTURE",
				"Name": {
					"Fn::Join": [
						"",
						[
							{
								"Fn::GetAtt": [
									"EmailIdentity",
									"DkimDNSTokenName2"
								]
							},
							"."
						]
					]
				},
				"ResourceRecords": [
					{
						"Fn::GetAtt": [
							"EmailIdentity",
							"DkimDNSTokenValue2"
						]
					}
				],
				"TTL": "300",
				"Type": "CNAME"
			}
		},
		"DkimRecord3": {
			"Type": "AWS::Route53::RecordSet",
			"Properties": {
				"HostedZoneId": "Z0000000000000FIXTURE",
				"Name": {
					"Fn::Join": [
						"",
						[
							{
								"Fn::GetAtt": [
									"EmailIdentity",
									"DkimDNSTokenName3"
								]
							},
							"."
						]
					]
				},
				"ResourceRecords": [
					{
						"Fn::GetAtt": [
							"EmailIdentity",
							"DkimDNSTokenValue3"
						]
					}
				],
				"TTL": "300",
				"Type": "CNAME"
			}
		},
		"CredentialsKey": {
			"Type": "AWS::KMS::Key",
			"Properties": {
				"Description": "TodoList (dev) envelope key for integration credentials",
				"Tags": [
					{
						"Key": "Project",
						"Value": "todolist"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			}
		},
		"CredentialsKeyAlias": {
			"Type": "AWS::KMS::Alias",
			"Properties": {
				"AliasName": "alias/todolist-dev-credentials",
				"TargetKeyId": {
					"Fn::GetAtt": [
						"CredentialsKey",
						"Arn"
					]
				}
			}
		},
		"HttpApi": {
			"Type": "AWS::ApiGatewayV2::Api",
			"Properties": {
				"CorsConfiguration": {
					"AllowCredentials": true,
					"AllowHeaders": [
						"Content-Type",
						"Authorization"
					],
					"AllowMethods": [
						"GET",
						"POST",
						"PUT",
						"PATCH",
						"DELETE",
						"OPTIONS",
						"HEAD"
					],
					"AllowOrigins": [
						"http://localhost:5173",
						"https://dev.example.com"
					],
					"MaxAge": 86400
				},
				"Name": "todolist-dev-api",
				"ProtocolType": "HTTP",
				"Tags": {
					"Project": "todolist",
					"Stage": "dev",
					"composer:used-by": {
						"Ref": "Distribution"
					}
				}
			}
		},
		"HttpApiDefaultStage": {
			"Type": "AWS::ApiGatewayV2::Stage",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AutoDeploy": true,
				"DefaultRouteSettings": {
					"ThrottlingBurstLimit": 20,
					"ThrottlingRateLimit": 10
				},
				"RouteSettings": {
					"ANY /api/public/auth/{proxy+}": {
						"ThrottlingRateLimit": 2,
						"ThrottlingBurstLimit": 5
					},
					"ANY /api/mcp": {
						"ThrottlingRateLimit": 5,
						"ThrottlingBurstLimit": 10
					},
					"ANY /api/mcp/{proxy+}": {
						"ThrottlingRateLimit": 5,
						"ThrottlingBurstLimit": 10
					}
				},
				"StageName": "$default",
				"Tags": {
					"Project": "todolist",
					"Stage": "dev"
				}
			}
		},
		"PublicRouteIntegration": {
			"Type": "AWS::ApiGatewayV2::Integration",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"IntegrationType": "AWS_PROXY",
				"IntegrationUri": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"PayloadFormatVersion": "2.0"
			}
		},
		"PublicRouteIntegrationPermission": {
			"Type": "AWS::Lambda::Permission",
			"Properties": {
				"Action": "lambda:InvokeFunction",
				"FunctionName": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"Principal": "apigateway.amazonaws.com",
				"SourceArn": {
					"Fn::Join": [
						"",
						[
							"arn:aws:execute-api:us-east-1:123456789012:",
							{
								"Ref": "HttpApi"
							},
							"/*/*/api/public/{proxy+}"
						]
					]
				}
			}
		},
		"PublicRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AuthorizationType": "NONE",
				"RouteKey": "ANY /api/public/{proxy+}",
				"Target": {
					"Fn::Join": [
						"",
						[
							"integrations/",
							{
								"Ref": "PublicRouteIntegration"
							}
						]
					]
				}
			}
		},
		"PublicAuthRouteIntegrationPermission": {
			"Type": "AWS::Lambda::Permission",
			"Properties": {
				"Action": "lambda:InvokeFunction",
				"FunctionName": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"Principal": "apigateway.amazonaws.com",
				"SourceArn": {
					"Fn::Join": [
						"",
						[
							"arn:aws:execute-api:us-east-1:123456789012:",
							{
								"Ref": "HttpApi"
							},
							"/*/*/api/public/auth/{proxy+}"
						]
					]
				}
			}
		},
		"PublicAuthRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AuthorizationType": "NONE",
				"RouteKey": "ANY /api/public/auth/{proxy+}",
				"Target": {
					"Fn::Join": [
						"",
						[
							"integrations/",
							{
								"Ref": "PublicRouteIntegration"
							}
						]
					]
				}
			}
		},
		"PrivateRouteIntegrationPermission": {
			"Type": "AWS::Lambda::Permission",
			"Properties": {
				"Action": "lambda:InvokeFunction",
				"FunctionName": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"Principal": "apigateway.amazonaws.com",
				"SourceArn": {
					"Fn::Join": [
						"",
						[
							"arn:aws:execute-api:us-east-1:123456789012:",
							{
								"Ref": "HttpApi"
							},
							"/*/*/api/private/{proxy+}"
						]
					]
				}
			}
		},
		"PrivateRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AuthorizationType": "JWT",
				"AuthorizerId": {
					"Ref": "HttpApiCognitoAuthorizer"
				},
				"RouteKey": "ANY /api/private/{proxy+}",
				"Target": {
					"Fn::Join": [
						"",
						[
							"integrations/",
							{
								"Ref": "PublicRouteIntegration"
							}
						]
					]
				}
			}
		},
		"HttpApiCognitoAuthorizer": {
			"Type": "AWS::ApiGatewayV2::Authorizer",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AuthorizerType": "JWT",
				"IdentitySource": [
					"$request.header.Authorization"
				],
				"JwtConfiguration": {
					"Audience": [
						{
							"Ref": "UserPoolClient"
						}
					],
					"Issuer": {
						"Fn::Join": [
							"",
							[
								"https://cognito-idp.us-east-1.amazonaws.com/",
								{
									"Ref": "UserPool"
								}
							]
						]
					}
				},
				"Name": "CognitoAuthorizer"
			}
		},
		"McpRouteIntegrationPermission": {
			"Type": "AWS::Lambda::Permission",
			"Properties": {
				"Action": "lambda:InvokeFunction",
				"FunctionName": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"Principal": "apigateway.amazonaws.com",
				"SourceArn": {
					"Fn::Join": [
						"",
						[
							"arn:aws:execute-api:us-east-1:123456789012:",
							{
								"Ref": "HttpApi"
							},
							"/*/*/api/mcp"
						]
					]
				}
			}
		},
		"McpRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AuthorizationType": "NONE",
				"RouteKey": "ANY /api/mcp",
				"Target": {
					"Fn::Join": [
						"",
						[
							"integrations/",
							{
								"Ref": "PublicRouteIntegration"
							}
						]
					]
				}
			}
		},
		"HttpApiMcpRouteIntegrationPermission": {
			"Type": "AWS::Lambda::Permission",
			"Properties": {
				"Action": "lambda:InvokeFunction",
				"FunctionName": {
					"Fn::GetAtt": [
						"Function",
						"Arn"
					]
				},
				"Principal": "apigateway.amazonaws.com",
				"SourceArn": {
					"Fn::Join": [
						"",
						[
							"arn:aws:execute-api:us-east-1:123456789012:",
							{
								"Ref": "HttpApi"
							},
							"/*/*/api/mcp/{proxy+}"
						]
					]
				}
			}
		},
		"HttpApiMcpRoute": {
			"Type": "AWS::ApiGatewayV2::Route",
			"Properties": {
				"ApiId": {
					"Ref": "HttpApi"
				},
				"AuthorizationType": "NONE",
				"RouteKey": "ANY /api/mcp/{proxy+}",
				"Target": {
					"Fn::Join": [
						"",
						[
							"integrations/",
							{
								"Ref": "PublicRouteIntegration"
							}
						]
					]
				}
			}
		},
		"Certificate": {
			"Type": "AWS::CertificateManager::Certificate",
			"Properties": {
				"DomainName": "dev.example.com",
				"DomainValidationOptions": [
					{
						"DomainName": "dev.example.com",
						"HostedZoneId": "Z0000000000000FIXTURE"
					}
				],
				"Tags": [
					{
						"Key": "Project",
						"Value": "todolist"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					},
					{
						"Key": "composer:used-by",
						"Value": {
							"Ref": "Distribution"
						}
					}
				],
				"ValidationMethod": "DNS"
			}
		},
		"OriginAccessControl": {
			"Type": "AWS::CloudFront::OriginAccessControl",
			"Properties": {
				"OriginAccessControlConfig": {
					"Name": "todolistdevEdgeOriginAccessControl527E22ED",
					"OriginAccessControlOriginType": "s3",
					"SigningBehavior": "always",
					"SigningProtocol": "sigv4",
					"Description": {
						"Fn::Sub": "Used by ${Distribution}"
					}
				}
			}
		},
		"SpaRewrite": {
			"Type": "AWS::CloudFront::Function",
			"Properties": {
				"AutoPublish": true,
				"FunctionConfig": {
					"Comment": "todolist-dev-spa-rewrite",
					"Runtime": "cloudfront-js-2.0"
				},
				"Name": "todolist-dev-spa-rewrite",
				"Tags": [
					{
						"Key": "Project",
						"Value": "todolist"
					},
					{
						"Key": "Stage",
						"Value": "dev"
					}
				]
			}
		},
		"Distribution": {
			"Type": "AWS::CloudFront::Distribution",
			"Properties": {
				"DistributionConfig": {
					"Aliases": [
						"dev.example.com"
					],
					"CacheBehaviors": [
						{
							"AllowedMethods": [
								"GET",
								"HEAD",
								"OPTIONS",
								"PUT",
								"PATCH",
								"POST",
								"DELETE"
							],
							"CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
							"Compress": true,
							"OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
							"PathPattern": "/api/*",
							"TargetOriginId": "todolistdevEdgeDistributionOrigin20C9B328F",
							"ViewerProtocolPolicy": "redirect-to-https"
						},
						{
							"CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
							"Compress": true,
							"OriginRequestPolicyId": "88a5eaf4-2fd4-4709-b370-b4c650ea3fcf",
							"PathPattern": "/media/*",
							"ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
							"TargetOriginId": "todolistdevEdgeDistributionOrigin3A1D2ACF1",
							"ViewerProtocolPolicy": "redirect-to-https"
						}
					],
					"Comment": "TodoList dev",
					"DefaultCacheBehavior": {
						"CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
						"Compress": true,
						"FunctionAssociations": [
							{
								"EventType": "viewer-request",
								"FunctionARN": {
									"Fn::GetAtt": [
										"SpaRewrite",
										"FunctionARN"
									]
								}
							}
						],
						"ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
						"TargetOriginId": "todolistdevEdgeDistributionOrigin1DAC7E1E6",
						"ViewerProtocolPolicy": "redirect-to-https"
					},
					"DefaultRootObject": "index.html",
					"Enabled": true,
					"HttpVersion": "http2and3",
					"IPV6Enabled": true,
